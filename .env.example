# Kopieren nach .env:  cp .env.example .env
# Schlüssel erzeugen:  openssl rand -hex 32
AGENT_API_KEY=
WEBUI_SECRET_KEY=

CHAT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

# Darf der Agent Webseiten abrufen und daraus lernen? (true/false)
AGENT_ALLOW_WEB=true
# Qwen3-"Thinking" an = klügere, aber langsamere Antworten
AGENT_THINK=true

# Darf Julia Einträge, Knowledge Bases und Skills löschen? (true/false)
# Ganze KBs und Skills landen zuerst im Papierkorb.
AGENT_ALLOW_DELETE=true
# Tage, bis der Papierkorb endgültig geleert wird
AGENT_TRASH_DAYS=14
# Kontextgröße des Modells (mehr = mehr RAM)
AGENT_NUM_CTX=16384

# Maximale Werkzeugschritte pro Antwort (jeder Schritt ist ein Modellaufruf)
AGENT_MAX_STEPS=30
