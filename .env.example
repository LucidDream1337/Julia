# Wird von setup.sh nach .env kopiert/ergänzt. Geheimnisse werden dort automatisch erzeugt.
PROJECT_DIR=

# --- Geheimnisse (setup.sh erzeugt zufällige Werte) ---
WEBUI_SECRET_KEY=

# --- Kontakt für den Crawler (Pflicht für Wikipedia, gute Praxis für alle) ---
# E-Mail oder URL; steht im User-Agent, damit Seitenbetreiber dich erreichen können.
CRAWLER_CONTACT=

# --- Modelle ---
# Für 6 GB VRAM (RTX 2060): qwen3:4b läuft komplett auf der GPU.
# qwen3:8b ist klüger, passt aber nur teilweise (langsamer). Ab 12 GB VRAM: qwen3:14b.
OLLAMA_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
JULIA_MODEL=julia
NUM_CTX=8192
# Qwen3-"Thinking": false = schneller und stabiler bei Werkzeugaufrufen
JULIA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HOST_PORT=11434

# --- Open WebUI ---
WEBUI_PORT=3001
# Nach dem Anlegen deines Admin-Kontos auf false setzen, damit sich niemand sonst registriert
WEBUI_ENABLE_SIGNUP=true
# Websuche (gilt nur beim ersten Start, danach zählt das Admin-Panel)
WEBUI_ENABLE_WEB_SEARCH=true
WEBUI_WEB_SEARCH_ENGINE=duckduckgo
WEBUI_WEB_SEARCH_RESULT_COUNT=3
WEBUI_WEB_SEARCH_BYPASS_EMBEDDING=true

# --- Wissens-Service ---
HARD_MAX_PAGES=5000
MIN_CRAWL_DELAY=2
SEARCH_MIN_SCORE=0.35
LOG_LEVEL=INFO
# QDRANT_IMAGE=qdrant/qdrant:latest
