# Kopieren nach .env:  cp .env.example .env
# Schlüssel erzeugen:  openssl rand -hex 32
AGENT_API_KEY=
WEBUI_SECRET_KEY=

CHAT_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text

# Darf der Agent Webseiten abrufen und daraus lernen? (true/false)
AGENT_ALLOW_WEB=false
# Qwen3-"Thinking" an = klügere, aber langsamere Antworten
AGENT_THINK=false
