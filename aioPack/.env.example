# Wird von setup.sh nach .env kopiert/ergänzt. Geheimnisse werden dort automatisch erzeugt.
PROJECT_DIR=/Projekte/Festplatten/int0SSD0

# --- Geheimnisse (setup.sh erzeugt zufällige Werte) ---
WEBUI_SECRET_KEY=
ADMIN_TOKEN=

# --- Ollama (Teil des Stacks) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Muss zu OLLAMA_CONTEXT_LENGTH des Ollama-Containers passen (wird aus diesem Wert abgeleitet)
OLLAMA_NUM_CTX=8192
# Qwen3-"Thinking" im Agenten (Query-Rewrite/Antworten): aus = schneller und stabiler
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HOST_PORT=11434

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=programming_knowledge

# --- Crawler / Worker ---
CRAWL_DELAY_SECONDS=2
MAX_PAGES_PER_RUN=25
CRAWL_INTERVAL_HOURS=24
RECRAWL_AFTER_DAYS=30

# --- RAG ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_QUERY_REWRITE=true

# --- Sonstiges ---
WEBUI_PORT=3001

# --- Open WebUI: Websuche (gilt nur beim ersten Start, danach zählt das Admin-Panel) ---
WEBUI_ENABLE_WEB_SEARCH=true
WEBUI_WEB_SEARCH_ENGINE=duckduckgo
WEBUI_WEB_SEARCH_RESULT_COUNT=3
WEBUI_WEB_SEARCH_BYPASS_EMBEDDING=true
LOG_LEVEL=INFO
