# Wird von setup.sh nach .env kopiert/ergänzt. Geheimnisse werden dort automatisch erzeugt.
PROJECT_DIR=/Projekte/Festplatten/int0SSD0

# --- Geheimnisse (setup.sh erzeugt zufällige Werte) ---
WEBUI_SECRET_KEY=
ADMIN_TOKEN=

# --- Ollama (Teil des Stacks) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_HOST_PORT=11434

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
COLLECTION_NAME=programming_knowledge

# --- Crawler / Worker ---
CRAWL_DELAY_SECONDS=2
MAX_PAGES_PER_RUN=25
CRAWL_INTERVAL_HOURS=24
RECRAWL_AFTER_DAYS=30

# --- RAG ---
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_QUERY_REWRITE=true

# --- Sonstiges ---
WEBUI_PORT=3001
LOG_LEVEL=INFO
